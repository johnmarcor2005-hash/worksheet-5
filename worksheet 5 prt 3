import json
from pathlib import Path

path = Path("favorite_number.json")

favorite_number = input("\nEnter your favourite number: ")

contents = json.dumps(favorite_number)

path.write_text(contents)

print("Favourite number saved.")

stored_number = json.loads(path.read_text())

print(f"Your favourite number is {stored_number}")


