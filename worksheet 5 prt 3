# --------------------------------------------
# Exercise 1 - File Reading with Error Handling
# --------------------------------------------

class PythonSummary:

    def __init__(self, filename):
        self.filename = filename

    def create_file(self):
        with open(self.filename, "w") as file:
            file.write("Python is easy to learn.\n")
            file.write("Python uses indentation.\n")
            file.write("Python supports OOP.\n")

    def read_entire_file(self):
        try:
            with open(self.filename, "r") as file:
                contents = file.read()
                print("\nEntire File Content:")
                print(contents)
        except FileNotFoundError:
            print("Error: File not found.")

    def read_line_by_line(self):
        try:
            with open(self.filename, "r") as file:
                lines = file.readlines()

                print("Reading Line by Line:")
                for line in lines:
                    print(line.strip())

        except FileNotFoundError:
            print("Error: File not found.")

summary = PythonSummary("python_summary.txt")
summary.create_file()
summary.read_entire_file()
summary.read_line_by_line()


